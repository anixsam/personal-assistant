# NVIDIA NIM (default router, called first)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Claude / Anthropic (delegation target, behind approval)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Claude Code (coding handoffs, behind approval). Folder it works in; leave empty to disable.
# Also starts the claude-code MCP server so the chat shows live progress while it works.
CLAUDE_CODE_CWD=
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# GitHub MCP server: starts only when GITHUB_TOKEN is set (fine-grained token). Read-only unless
# JARVIS_GITHUB_READONLY=0. JARVIS_GITHUB_REPOS=owner/a,owner/b limits which repos it can touch.
GITHUB_TOKEN=
JARVIS_GITHUB_REPOS=
JARVIS_GITHUB_READONLY=
# Voice (Piper, local). Run `pnpm voice:setup` once; leave PIPER_BIN empty to use ./voices
PIPER_BIN=
PIPER_VOICE=en_GB-northern_english_male-medium
# Other stock voices: pnpm voice:setup <name>, e.g. en_GB-alan-medium, en_GB-cori-high
# Speaking pace: 1 is normal, 0.9 a little quicker, 1.1 a little slower
PIPER_LENGTH_SCALE=
# Speaker number for multi-speaker voices such as en_GB-vctk-medium or en_GB-semaine-medium
PIPER_SPEAKER=

# Server
PORT=8787
CORS_ORIGIN=http://localhost:3000

# Web UI: where the Friday server runs
JARVIS_API_URL=http://127.0.0.1:8787

# Filesystem MCP server: starts only when JARVIS_FS_ROOT is set; the only folder Friday can see.
# Read-only unless JARVIS_FS_READONLY=0.
JARVIS_FS_ROOT=
JARVIS_FS_READONLY=
# Keep a configured MCP server off, e.g. JARVIS_MCP_DISABLE=github
JARVIS_MCP_DISABLE=
