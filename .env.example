# NVIDIA NIM (default router, called first)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Claude / Anthropic (delegation target, behind approval)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Claude Code (coding handoffs, behind approval). Folder it works in; leave empty to disable.
CLAUDE_CODE_CWD=
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# GitHub MCP server: fine-grained token; optional repo allowlist and read-only switch
GITHUB_TOKEN=
JARVIS_GITHUB_REPOS=
JARVIS_GITHUB_READONLY=
# Voice (Piper, local). Run `pnpm voice:setup` once; leave PIPER_BIN empty to use ./voices
PIPER_BIN=
PIPER_VOICE=en_GB-alan-medium

# Server
PORT=8787
CORS_ORIGIN=http://localhost:3000

# Web UI: where the Jarvis server runs
JARVIS_API_URL=http://127.0.0.1:8787

# Filesystem MCP server: the only folder Jarvis can read/write. JARVIS_FS_READONLY=1 disables writes.
JARVIS_FS_ROOT=
JARVIS_FS_READONLY=
